# Minimum tool runtime configuration. The environment must be selected explicitly; there is no fallback.
CODEX_API_KEY=
DEBUGGING_CODEX_MODEL=gpt-5.6-sol
DEBUGGING_CODEX_BIN=codex
DEBUGGING_RESULTS_DIR=./experiments
# Required: host (with the toolchain/dependencies installed) or image (a prebuilt OCI image).
DEBUGGING_ENVIRONMENT_BACKEND=
# Required when backend=image; the tool does not build or pull the image.
DEBUGGING_ENVIRONMENT_IMAGE=
# Set docker or podman; auto selects the runtime only and does not change the environment mode.
DEBUGGING_ENVIRONMENT_RUNTIME=auto

# Partners do not need to configure CodeGraph: it defaults to auto, uses a 180-second timeout,
# and uses the bundled runtime. Uncomment the lines below only for advanced overrides.
# DEBUGGING_CONTEXT_MODE=auto
# DEBUGGING_CODEGRAPH_TIMEOUT=3600
# DEBUGGING_CODEGRAPH_BIN=/absolute/path/to/codegraph

# Advanced provider/API settings (only needed when not using the default Codex configuration):
# DEBUGGING_CODEX_PROVIDER=
# DEBUGGING_CODEX_BASE_URL=
# DEBUGGING_CODEX_WIRE_API=responses
# DEBUGGING_CODEX_ENV_KEY=CODEX_API_KEY
