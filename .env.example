# Runtime tối thiểu của tool. Environment phải được chọn rõ, không có fallback.
CODEX_API_KEY=
DEBUGGING_CODEX_MODEL=gpt-5.6-sol
DEBUGGING_CODEX_BIN=codex
DEBUGGING_RESULTS_DIR=./experiments
# Bắt buộc: host (đã cài đủ toolchain/dependency) hoặc image (OCI đã build sẵn).
DEBUGGING_ENVIRONMENT_BACKEND=
# Bắt buộc khi backend=image; tool không tự build hoặc pull image.
DEBUGGING_ENVIRONMENT_IMAGE=
# Có thể đặt docker hoặc podman; auto chỉ tự chọn runtime, không đổi environment mode.
DEBUGGING_ENVIRONMENT_RUNTIME=auto

# CodeGraph không cần cấu hình cho partner: mặc định auto, timeout 180 giây và
# tự dùng runtime bundled. Chỉ bỏ comment các dòng dưới khi cần override nâng cao.
# DEBUGGING_CONTEXT_MODE=auto
# DEBUGGING_CODEGRAPH_TIMEOUT=3600
# DEBUGGING_CODEGRAPH_BIN=/absolute/path/to/codegraph

# Provider/API nâng cao (chỉ cần khi không dùng cấu hình Codex mặc định):
# DEBUGGING_CODEX_PROVIDER=
# DEBUGGING_CODEX_BASE_URL=
# DEBUGGING_CODEX_WIRE_API=responses
# DEBUGGING_CODEX_ENV_KEY=CODEX_API_KEY
